# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key.
# BusyLab works fully without any of this: with no key the engine's own
# wording is used and every number is identical, only the prose is plainer.

# Groq free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Which model writes the sentences. Narration is cached per finding, so
# volume stays low and the larger model is affordable on the free tier.
BUSYLAB_LLM_MODEL=llama-3.3-70b-versatile

# Set to "none" to force the model off even when a key is present.
# BUSYLAB_LLM_PROVIDER=none

# --- API only, all optional -------------------------------------------
# BUSYLAB_DB=busylab.db
# BUSYLAB_STORAGE=storage
# BUSYLAB_CORS=http://localhost:3000

# Scheduled refresh (spec Pillar 2). Without this the endpoint stays closed.
# BUSYLAB_SCHEDULER_TOKEN=

# Digest delivery. Unset means the digest is written to the log, not sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# BUSYLAB_MAILER=log

# Production only. Postgres (Supabase) instead of local SQLite.
# DATABASE_URL=postgresql://...

# Supabase Storage for uploads. Unset means a local folder.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=uploads

# Where the weekly digest is sent. Unset means it is only logged.
# BUSYLAB_DIGEST_TO=

# --- Language model ----------------------------------------------------
# Two options, both optional. BusyLab runs fully without either: the numbers
# are identical and only the prose is plainer.
#
# Groq's free tier is fastest to set up. OpenRouter reaches stronger
# open-weight models and is used in preference when both keys are present.
#
# OPENROUTER_API_KEY=sk-or-...
# Model ids on OpenRouter are always vendor/model. A bare Groq name such as
# llama-3.3-70b-versatile is ignored with a warning, since it would 404.
# BUSYLAB_LLM_MODEL=deepseek/deepseek-chat
#
# Force one or the other, or off entirely:
# BUSYLAB_LLM_PROVIDER=openrouter | groq | none
